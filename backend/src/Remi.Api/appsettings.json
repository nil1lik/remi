{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Remi": ""
  },
  "Auth": {
    "SigningKey": "",
    "Apple": { "ClientIds": [ "com.niloya.remi" ] },
    "Google": { "ClientIds": [] }
  },
  "Database": { "MigrateOnStartup": false },
  "Network": { "KnownProxies": [] },
  "RateLimits": { "AuthPerMinute": 10, "ApiPerMinute": 300 }
}
