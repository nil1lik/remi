# Bu dosyayı .env olarak kopyala ve doldur. .env depoya girmez.
# Veritabanı şifresi: uzun ve rastgele olsun (örn. `openssl rand -base64 24`).
POSTGRES_PASSWORD=
# Erişim anahtarlarını imzalayan gizli anahtar, en az 32 bayt: `openssl rand -base64 32`
AUTH_SIGNING_KEY=
# Google ile giriş için iOS istemci kimliği (Google Cloud Console > Credentials). Boşsa Google girişi kapalı.
GOOGLE_IOS_CLIENT_ID=
